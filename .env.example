# App
APP_BASE_URL=https://anaptiras.com
NODE_ENV=production

# Postgres (Neon / Vercel Postgres)
DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require&pooler=true

# KV (Upstash via Vercel)
KV_URL=https://<your-upstash-rest-url>
KV_TOKEN=<your-upstash-rest-token>

# Blob (Vercel Blob)
BLOB_READ_WRITE_TOKEN=<your-vercel-blob-rw-token>

# Turnstile (Cloudflare)
TURNSTILE_SITE_KEY=<your-turnstile-site-key>       # (Μπορεί να είναι δημόσιο)
TURNSTILE_SECRET=<your-turnstile-secret>           # (Μυστικό - μόνο server)

# Consent / Ads
CONSENT_MODE_ENABLED=true

# Google Ad Manager (GAM)
GAM_NETWORK_CODE=<your_gam_code>                  # π.χ. 12345678
GAM_AD_UNIT_BASE=/12345678/anaptiras              # ή placeholder μέχρι approval

# Prebid (multi-provider)
PREBID_TIMEOUT_MS=1000
PREBID_BIDDERS_JSON=["appnexus","pubmatic","openx","indexExchange","triplelift","magnite","criteo","rubicon"]
